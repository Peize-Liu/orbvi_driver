prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: orbvi_sdk
Description: ORBVI 4P ROS-free Linux Host SDK
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lorbvi_sdk
Requires.private: libavformat libavcodec libavutil libswscale
Cflags: -I${includedir}
